# Add these values to the protected runtime environment, never to Git.
# Generate the token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRADINGVIEW_WEBHOOK_TOKEN=replace-with-a-random-secret

# The paper account is local to LANA and has no relation to a broker account.
LANA_PAPER_INITIAL_EQUITY=10000
